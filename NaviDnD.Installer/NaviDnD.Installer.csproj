<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>../NaviDnD/dnd.ico</ApplicationIcon>
  </PropertyGroup>
  <!-- Window and message language: the game's shared L; translations are only the installer's strings (ru.json alongside), so
       edits to the game's text don't rebuild the installer. -->
  <ItemGroup>
    <Compile Include="../NaviDnD.Data/L.cs" Link="L.cs" />
    <EmbeddedResource Include="ru.json" LogicalName="NaviDnD.Localization.ru.json" />
  </ItemGroup>
</Project>
